{
  "name": "pro-market-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend API server for PRO Market Dashboard - aggregates product listings from multiple sources",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "lint": "eslint src/**/*.ts",
    "db:init": "ts-node src/db/init.ts"
  },
  "keywords": [
    "market",
    "dashboard",
    "price-comparison",
    "aggregator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "axios": "^1.6.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/body-parser": "^1.19.5",
    "@types/sqlite3": "^3.1.11",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11",
    "fast-check": "^3.15.0"
  }
}
