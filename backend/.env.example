# PRO Market Dashboard - API Configuration
# Copy this file to .env and fill in your actual API keys

# Server Configuration
PORT=3000
NODE_ENV=development

# Amazon Product Advertising API
# Sign up at: https://affiliate-program.amazon.in/
AMAZON_ACCESS_KEY=your_amazon_access_key_here
AMAZON_SECRET_KEY=your_amazon_secret_key_here
AMAZON_PARTNER_TAG=your_amazon_partner_tag_here
AMAZON_REGION=in

# eBay Finding API
# Sign up at: https://developer.ebay.com/
EBAY_APP_ID=your_ebay_app_id_here
EBAY_CERT_ID=your_ebay_cert_id_here
EBAY_DEV_ID=your_ebay_dev_id_here
EBAY_SITE_ID=203

# Flipkart Affiliate API (Indian marketplace)
# Sign up at: https://affiliate.flipkart.com/
FLIPKART_AFFILIATE_ID=your_flipkart_affiliate_id_here
FLIPKART_AFFILIATE_TOKEN=your_flipkart_token_here

# Walmart API (Optional)
# Sign up at: https://developer.walmart.com/
WALMART_API_KEY=your_walmart_api_key_here
WALMART_CLIENT_ID=your_walmart_client_id_here

# Cache Configuration
CACHE_TTL_SECONDS=600

# Database Configuration
DB_PATH=./data/market.db

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
